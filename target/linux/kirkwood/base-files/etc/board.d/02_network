. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update

board=$(board_name)

case "$board" in
"zte,f460-f660"|\
"zte,f420-f620"|\
"hqw,hgg420n")
	ucidef_set_interfaces_lan_wan "ethernet1 ethernet2 ethernet3 ethernet4" "internet"
	ucidef_set_interface_macaddr "wan" $( mtd_get_mac_ascii uboot_env eth1addr )
	;;
*)
	ucidef_set_interface_lan "eth0"
	;;
esac

board_config_flush

exit 0
